# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage files.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore uploaded files in development.
/storage/*
/public/uploads

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore database files
/storage/*.sqlite3
/storage/*.sqlite3-*
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore test database files
/storage/test*.sqlite3*

# Ignore uploads directory
/tmp/uploads/*
!/tmp/uploads/.keep
/tmp/test_uploads/*
/tmp/import_*.csv
/tmp/*.rb
/tmp/*.html

# Ignore node_modules
/node_modules

# Ignore yarn files
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore assets
/public/assets
/public/packs
/public/packs-test
/public/test_900_transactions.csv
/public/test_5000_transactions.csv

# Ignore precompiled assets
*.log
*.pid
*.seed

# Ignore all .DS_Store files (macOS)
.DS_Store
.DS_Store?

# Ignore Byebug command history file.
.byebug_history

# Ignore Kamal secrets
/.kamal/secrets

# Ignore Solid Queue database
/db/queue.sqlite3*
/db/queue_schema.rb

# Ignore Solid Cache database
/db/cache.sqlite3*
/db/cache_schema.rb

# Ignore Solid Cable database
/db/cable.sqlite3*
/db/cable_schema.rb

# Ignore coverage reports
/coverage/

# Ignore RubyMine project files
.idea/
*.iml

# Ignore VS Code settings
.vscode/

# Ignore Vim swap files
*.swp
*.swo
*~

# Ignore ctags
tags
TAGS

# Ignore RuboCop cache
.rubocop-cache

# Ignore Brakeman output
brakeman-output.*

# Ignore bundler binstubs
/bin/bundle

# Ignore spring files
/spring/*.pid

# Ignore temporary files
*.tmp
*.bak
*.backup

# Ignore documentation cache
.yardoc/
doc/

# Ignore simplecov
coverage/

# Ignore test artifacts
/test/tmp/

# Ignore local development scripts
/bin/dev.local

