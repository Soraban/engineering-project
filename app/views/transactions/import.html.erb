<div class="import-container">
  <h1>Import Transactions from CSV</h1>

  <div class="import-instructions">
    <h3>Instructions</h3>
    <ul>
      <li>Your CSV file must have headers: <code>date</code>, <code>description</code>, <code>amount</code>, <code>category</code></li>
      <li>Supported date formats: YYYY-MM-DD, MM/DD/YYYY, DD/MM/YYYY, and more</li>
      <li>Amounts can include currency symbols ($, €, £) and commas</li>
      <li>Category is optional - rules will auto-categorize if left blank</li>
      <li><strong>Large files (1000+ rows)</strong> will be processed in the background - you'll see a status page</li>
      <li><strong>Small files (&lt; 1000 rows)</strong> will be processed immediately</li>
    </ul>
    
    <div class="download-template">
      <%= link_to '📥 Download Sample CSV Template', '/sample_transactions.csv', class: 'btn btn-secondary', download: true %>
    </div>
  </div>

  <%= form_with url: import_transactions_path, method: :post, multipart: true, local: true, class: 'import-form', id: 'import-form' do |f| %>
    <div class="form-group">
      <%= f.label :file, 'Select CSV File' %>
      <div class="file-input-wrapper">
        <%= f.file_field :file, accept: '.csv', class: 'file-input', required: true %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit 'Import Transactions', class: 'btn btn-primary btn-large', id: 'import-submit' %>
      <%= link_to 'Cancel', transactions_path, class: 'btn btn-secondary' %>
    </div>

    <!-- Loading indicator -->
    <div id="import-loading" class="import-loading" style="display: none;">
      <div class="spinner"></div>
      <p class="loading-text">Processing your import...</p>
      <p class="loading-subtext">This may take a few moments for large files.</p>
    </div>
  <% end %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('import-form');
      const submitButton = document.getElementById('import-submit');
      const loadingDiv = document.getElementById('import-loading');
      
      if (form && submitButton && loadingDiv) {
        form.addEventListener('submit', function(e) {
          const fileInput = form.querySelector('input[type="file"]');
          
          // Only show spinner if file is selected
          if (fileInput && fileInput.files.length > 0) {
            // Show spinner immediately
            loadingDiv.style.display = 'block';
            submitButton.disabled = true;
            submitButton.value = 'Processing...';
            
            // Hide the form to make spinner more prominent
            form.querySelector('.form-group').style.display = 'none';
            form.querySelector('.form-actions').style.display = 'none';
          }
        });
      }
    });
  </script>

  <div class="import-features">
    <h3>Import Features</h3>
    <div class="features-grid">
      <div class="feature-card">
        <h4>🔍 Edge Case Handling</h4>
        <p>Handles missing fields, malformed data, and empty rows gracefully</p>
      </div>
      
      <div class="feature-card">
        <h4>🚫 Duplicate Detection</h4>
        <p>Automatically flags duplicate transactions for your review</p>
      </div>
      
      <div class="feature-card">
        <h4>⚡ Auto-Categorization</h4>
        <p>Your categorization rules will be automatically applied to imported transactions</p>
      </div>
      
      <div class="feature-card">
        <h4>🔔 Anomaly Detection</h4>
        <p>Imported transactions are checked for unusual patterns and potential fraud</p>
      </div>
    </div>
  </div>

  <!-- Example Preview -->
  <div class="example-section">
    <h3>Example CSV Format</h3>
    <pre class="csv-example">date,description,amount,category
2024-01-15,Amazon Purchase - Electronics,299.99,Shopping
2024-01-16,Whole Foods Market,67.50,Food & Dining
2024-01-17,Shell Gas Station,45.00,Transportation
2024-01-18,Netflix Subscription,15.99,Entertainment</pre>
  </div>
</div>

