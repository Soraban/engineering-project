<div class="dashboard-container">
  <h1>Transaction Dashboard</h1>

  <!-- Statistics Overview -->
  <div class="stats-grid">
    <div class="stat-card">
      <h3>Total Transactions</h3>
      <p class="stat-number"><%= number_with_delimiter(@total_transactions) %></p>
    </div>
    
    <div class="stat-card warning">
      <h3>Uncategorized</h3>
      <p class="stat-number"><%= number_with_delimiter(@uncategorized_count) %></p>
      <%= link_to 'Review', transactions_path(uncategorized: true), class: 'stat-link' %>
    </div>
    
    <div class="stat-card alert">
      <h3>Flagged Transactions</h3>
      <p class="stat-number"><%= number_with_delimiter(@flagged_count) %></p>
      <%= link_to 'Review', review_dashboard_path(filter: 'flagged'), class: 'stat-link' %>
    </div>
    
    <div class="stat-card critical">
      <h3>Unresolved Anomalies</h3>
      <p class="stat-number"><%= number_with_delimiter(@unresolved_anomalies_count) %></p>
      <%= link_to 'Review', review_dashboard_path(filter: 'anomalies'), class: 'stat-link' %>
    </div>
  </div>

  <!-- Anomaly Breakdown -->
  <% if @anomalies_by_type.any? %>
    <div class="section">
      <h2>Anomalies by Type</h2>
      <div class="anomaly-breakdown">
        <% @anomalies_by_type.each do |type, count| %>
          <div class="anomaly-item">
            <span class="anomaly-label"><%= type.humanize %></span>
            <span class="anomaly-count"><%= count %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="section">
      <h2>Anomalies by Severity</h2>
      <div class="severity-breakdown">
        <% @anomalies_by_severity.each do |severity, count| %>
          <div class="severity-item severity-<%= severity %>">
            <span class="severity-label"><%= severity.upcase %></span>
            <span class="severity-count"><%= count %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Transactions Needing Review -->
  <div class="section">
    <h2>Transactions Needing Review</h2>
    <% if @needs_review.any? %>
      <div class="table-container">
        <table class="transactions-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Description</th>
              <th>Amount</th>
              <th>Category</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @needs_review.each do |transaction| %>
              <tr class="<%= 'flagged' if transaction.flagged? %>">
                <td><%= transaction.date.strftime('%Y-%m-%d') %></td>
                <td><%= truncate(transaction.description, length: 50) %></td>
                <td class="amount"><%= number_to_currency(transaction.amount) %></td>
                <td>
                  <% if transaction.category %>
                    <span class="category-badge"><%= transaction.category.name %></span>
                  <% else %>
                    <span class="badge-uncategorized">Uncategorized</span>
                  <% end %>
                </td>
                <td>
                  <span class="status-badge status-<%= transaction.status %>">
                    <%= transaction.status.humanize %>
                  </span>
                  <% if transaction.flagged? %>
                    <span class="badge-flagged">⚠ Flagged</span>
                  <% end %>
                </td>
                <td>
                  <%= link_to 'View', transaction_path(transaction), class: 'btn btn-sm' %>
                  <%= link_to 'Edit', edit_transaction_path(transaction), class: 'btn btn-sm' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= link_to 'View All Pending Reviews', review_dashboard_path, class: 'btn btn-primary' %>
    <% else %>
      <p class="empty-state">No transactions need review at this time! 🎉</p>
    <% end %>
  </div>

  <!-- Category Distribution -->
  <% if @category_stats.any? %>
    <div class="section">
      <h2>Top Categories</h2>
      <div class="category-stats">
        <% @category_stats.each do |stat| %>
          <div class="category-stat-item">
            <div class="category-name"><%= stat.category %></div>
            <div class="category-details">
              <span class="transaction-count"><%= stat.count %> transactions</span>
              <span class="total-amount"><%= number_to_currency(stat.total) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Quick Actions -->
  <div class="section quick-actions">
    <h2>Quick Actions</h2>
    <div class="action-buttons">
      <%= link_to '+ Add Transaction', new_transaction_path, class: 'btn btn-primary' %>
      <%= link_to '📤 Import CSV', import_transactions_path, class: 'btn btn-secondary' %>
      <%= link_to '⚙️ Manage Rules', categorization_rules_path, class: 'btn btn-secondary' %>
      <%= link_to '📊 All Transactions', transactions_path, class: 'btn btn-secondary' %>
    </div>
  </div>
</div>

<style>
