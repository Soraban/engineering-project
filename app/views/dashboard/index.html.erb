  align-items: center;
  padding: 15px;
  background: #f8f9fa;
  border-radius: 6px;
  border-left: 3px solid #3498db;
}

.severity-item.severity-low {
  border-left-color: #27ae60;
}

.severity-item.severity-medium {
  border-left-color: #f39c12;
}

.severity-item.severity-high {
  border-left-color: #e74c3c;
}

.severity-item.severity-critical {
  border-left-color: #c0392b;
}

.anomaly-label, .severity-label {
  font-weight: 600;
}

.anomaly-count, .severity-count {
  font-size: 1.5em;
  font-weight: bold;
  color: #2c3e50;
}

.table-container {
  overflow-x: auto;
  margin-bottom: 20px;
}

.transactions-table {
  width: 100%;
