<%# Don't cache this page - it's dynamic %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%# Subscribe to WebSocket updates for real-time status %>
<%= turbo_stream_from "import_#{@import_id}" %>

<div class="import-status-container">
  <h1>Import Status</h1>

  <%= render "transactions/import_status_card", status: @status %>
</div>

<style>
  .import-status-container {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .status-card {
    background: white;
    border-radius: 8px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .status-queued,
  .status-processing,
  .status-completed,
  .status-failed {
    text-align: center;
  }

  /* Phase Header */
  .phase-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .phase-info h2 {
    margin: 0;
    font-size: 1.8rem;
    color: #2c3e50;
  }
  
  .subtitle {
    color: #7f8c8d;
    font-size: 1rem;
    margin: 0.5rem 0 0 0;
  }
  
  .checkmark-icon {
    width: 60px;
    height: 60px;
    background: #27ae60;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: bold;
  }
  
  /* Progress Display */
  .progress-display {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 2rem;
    border-radius: 12px;
    margin: 2rem 0;
    color: white;
  }
  
  .progress-display.secondary {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    padding: 1.5rem;
  }
  
  .big-number {
    font-size: 4rem;
    font-weight: bold;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  
  .progress-label {
    font-size: 1.2rem;
    opacity: 0.9;
  }
  
  .progress-label-large {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  
  .progress-info {
    flex: 1;
  }
  
  /* Progress Bar */
  .progress-bar-container {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    height: 20px;
    margin: 1rem 0;
    overflow: hidden;
  }
  
  .progress-bar {
    height: 100%;
    background: white;
    border-radius: 10px;
    transition: width 0.3s ease;
  }
  
  .progress-text {
    font-size: 1rem;
    opacity: 0.95;
  }
  
  .timestamp {
    color: #7f8c8d;
    font-size: 0.9rem;
    margin-top: 2rem;
  }
  
  .anomaly-status {
    margin-top: 1.5rem;
    padding: 1rem;
    background: #e3f2fd;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  
  .spinner-small,
  .mini-spinner {
    width: 24px;
    height: 24px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top: 3px solid white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  
  .info-text {
    margin: 0;
    color: #1565c0;
    font-size: 0.95rem;
  }

  /* Completion State */
  .status-completed {
    text-align: center;
  }
  
  .completion-header {
    margin-bottom: 2.5rem;
  }
  
  .success-circle {
    display: inline-block;
    animation: scaleIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    margin-bottom: 1rem;
  }
  
  @keyframes scaleIn {
    0% { transform: scale(0) rotate(-45deg); opacity: 0; }
    50% { transform: scale(1.1) rotate(5deg); }
    100% { transform: scale(1) rotate(0deg); opacity: 1; }
  }
  
  .success-title {
    color: #27ae60;
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0.5rem 0;
  }
  
  .success-subtitle {
    color: #7f8c8d;
    font-size: 1.1rem;
    margin: 0.5rem 0 0 0;
  }
  
  /* Completion Stats Grid */
  .completion-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }
  
  .stat-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: transform 0.2s;
  }
  
  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
  }
  
  .stat-primary {
    border-left: 4px solid #27ae60;
  }
  
  .stat-warning {
    border-left: 4px solid #f39c12;
  }
  
  .stat-info {
    border-left: 4px solid #3498db;
  }
  
  .stat-icon {
    font-size: 2.5rem;
    line-height: 1;
  }
  
  .stat-content {
    flex: 1;
    text-align: left;
  }
  
  .stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: #2c3e50;
    line-height: 1;
  }
  
  .stat-label {
    font-size: 0.95rem;
    color: #7f8c8d;
    margin-top: 0.5rem;
    font-weight: 500;
  }
  
  .completion-time {
    color: #95a5a6;
    font-size: 0.95rem;
    margin: 2rem 0 1.5rem 0;
  }
  
  .info-banner {
    background: #e3f2fd;
    padding: 1rem 1.5rem;
    border-radius: 6px;
    margin: 1.5rem 0;
    color: #1565c0;
    border-left: 4px solid #2196f3;
  }

  .status-failed h2 {
    color: #dc3545;
  }

  .import-results {
    margin: 2rem 0;
    padding: 1.5rem;
    background: #f8f9fa;
    border-radius: 6px;
  }

  .import-results p {
    margin: 0.5rem 0;
    font-size: 1.1rem;
  }

  .errors-count {
    color: #dc3545;
  }

  .completed-time {
    font-size: 0.9rem;
    color: #666;
  }

  .error-details {
    margin: 2rem 0;
    text-align: left;
    background: #fff3cd;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #f39c12;
  }

  .error-details h3 {
    margin: 0 0 0.5rem 0;
    color: #856404;
    font-size: 1.2rem;
  }
  
  .error-intro {
    color: #856404;
    margin: 0.5rem 0 1rem 0;
    font-size: 0.95rem;
  }

  .error-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .error-row {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    background: white;
    padding: 0.6rem 0.75rem;
    border-radius: 4px;
    border-left: 3px solid #e67e22;
    font-size: 0.95rem;
  }
  
  .error-row.more {
    background: transparent;
    border: none;
    color: #856404;
    font-style: italic;
  }
  
  .error-number {
    font-weight: bold;
    color: #e67e22;
    font-size: 0.9rem;
    min-width: 25px;
    flex-shrink: 0;
  }
  
  .error-reason {
    color: #d35400;
    font-weight: 500;
    flex-shrink: 0;
  }
  
  .error-arrow {
    color: #95a5a6;
    flex-shrink: 0;
  }
  
  .error-data-inline {
    color: #2c3e50;
    font-family: 'Courier New', monospace;
    font-weight: 600;
    overflow-x: auto;
    white-space: nowrap;
  }
  
  .error-text {
    color: #856404;
  }

  .error-message {
    color: #dc3545;
    font-weight: 500;
    padding: 1rem;
    background: #f8d7da;
    border-radius: 6px;
    margin: 1.5rem 0;
  }

  .row-count {
    font-size: 1.2rem;
    font-weight: 600;
    color: #3498db;
  }

  .help-text {
    font-size: 0.9rem;
    color: #666;
    margin-top: 1rem;
  }

  .actions {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    display: inline-block;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #3498db;
    color: white;
    border: none;
  }

  .btn-primary:hover {
    background: #2980b9;
  }

  .btn-secondary {
    background: #6c757d;
    color: white;
    border: none;
  }

  .btn-secondary:hover {
    background: #5a6268;
  }
  
  /* Spinner animations */
  .spinner {
    width: 60px;
    height: 60px;
    border: 6px solid #f3f3f3;
    border-top: 6px solid #3498db;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

